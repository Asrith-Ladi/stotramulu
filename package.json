{
  "name": "stotramulu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy -c dist/stotramulu/wrangler.json",
    "verify": "node tools/verify.cjs",
    "shots": "vite build && node tools/screenshots.cjs",
    "e2e": "vite build && node tools/review-devotional.cjs && node tools/e2e-conversations.cjs && node tools/e2e-build-check.cjs",
    "rules:check": "node tools/rules-check/test-rules.cjs && node tools/rules-check/test-rules-round2.cjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@fontsource-variable/noto-serif-telugu": "^5.3.0"
  }
}
