        "text": "ఓం భక్తానాం మాతృ ధాతృ పితామహాయ నమః"
      },
      {
        "name": 42,
        "text": "ఓం భక్త అభయ ప్రదాయ నమః"
      },
      {
        "name": 43,
        "text": "ఓం భక్త పరాధీనాయ నమః"
      },
      {
        "name": 44,
        "text": "ఓం భక్త అనుగ్రహ కాతరాయ నమః"
      },
      {
        "name": 49,
        "text": "ఓం సంశయ హృదయ దౌర్బల్య పాప కర్మ వాసనా క్షయ కరాయ నమః"
      },
      {
        "name": 50,
        "text": "ఓం హృది బోధ దాయ నమః"
      },
      {
        "name": 51,
        "text": "ఓం నాశ హేత వే నమః"
      },
      {
        "name": 53,
        "text": "ఓం శుద్ధ సత్త్వ స్థితాయ నమః"
      },
      {
        "name": 57,
        "text": "ఓం జయినే నమః"
      },
      {
        "name": 58,
        "text": "ఓం దుర్ధర్ష క్షోభ్యాయ నమః"
      },
      {
        "name": 60,
        "text": "ఓం త్రిలోకేషు అవిఘాత గతయే నమః"
      },
      {
        "name": 61,
        "text": "ఓం అశక్య రహితాయ నమః"
      },
      {
        "name": 63,
        "text": "ఓం సురూప సుందరాయ నమః"
      },
      {
        "name": 66,
        "text": "ఓం అరూప అవ్యక్తాయ నమః"
      },
      {
        "name": 73,
        "text": "ఓం అసహాయ సహాయాయ నమః"
      },
      {
        "name": 74,
        "text": "ఓం అనాథ నాథ దీన బంధవే నమః"
      },
      {
        "name": 75,
        "text": "ఓం సర్వ భార భృతే నమః"
      },
      {
        "name": 76,
        "text": "ఓం అకర్మ అనేక కర్మ సు కర్మిణే నమః"
      },
      {
        "name": 81,
        "text": "ఓం సత్పరాయణాయ నమః"
      },
      {
        "name": 83,
        "text": "ఓం పావన అనఘాయ నమః"
      },
      {
        "name": 86,
        "text": "ఓం బ్రహ్మచర్య తపశ్చర్యాది సు వ్రతాయ నమః"
      },
      {
        "name": 88,
        "text": "ఓం సిద్ధేశ్వరాయ నమః"
      },
      {
        "name": 89,
        "text": "ఓం సిద్ధ సంకల్పాయ నమః"
      },
      {
        "name": 90,
        "text": "ఓం యోగేశ్వరాయ నమః"
      },
      {
        "name": 93,
        "text": "ఓం సత్పురుషాయ నమః"
      },
      {
        "name": 95,
        "text": "ఓం సత్య తత్త్వ బోధకాయ నమః"
      },
      {
        "name": 96,
        "text": "ఓం కామాది షడ్వైరి ధ్వంసినే నమః"
      },
      {
        "name": 97,
        "text": "ఓం అభేదానంద అనుభవ ప్రదాయ నమః"
      },
      {
        "name": 99,
        "text": "ఓం శ్రీ దక్షిణామూర్తయే నమః"
      },
      {
        "name": 100,
        "text": "ఓం శ్రీ వేంకటేశ రమణాయ నమః"
      },
      {
        "name": 101,
        "text": "ఓం అద్భుత ఆనంద చర్యాయ నమః"
      },
      {
        "name": 102,
        "text": "ఓం ప్రపన్న ఆర్తి హరాయ నమః"
      },
      {
        "name": 103,
        "text": "ఓం సంసార సర్వ దుఃఖ క్షయ కరాయ నమః"
      },
      {
        "name": 105,
        "text": "ఓం సర్వాంతర్బహిః స్థితాయ నమః"
      },
      {
        "name": 107,
        "text": "ఓం సర్వ అభీష్ట ప్రదాయ నమః"
      },
      {
        "name": 108,
        "text": "ఓం సమర్థ సద్గురు సాయినాథాయ నమః"
      }
    ]
  }
}