/**
 * Cloudflare Workers config for the stotramulu site.
 *
 * Dev:     npm run dev      (Vite dev server + Worker, via @cloudflare/vite-plugin)
 * Build:   npm run build    (outputs dist/client + dist/stotramulu)
 * Deploy:  npm run deploy   (builds, then deploys the generated dist/stotramulu/wrangler.json —
 *                            NOT this file directly; @cloudflare/vite-plugin regenerates a
 *                            build-output-relative config on every build)
 *
 * Layout this expects:
 *   index.html, admin.html → Vite entries at the repo root
 *   styles/  → CSS Vite/Tailwind actually processes
 *   public/  → static passthrough (assets/*.js, data/*.js) copied through untouched
 *   src/     → the Worker, which only handles POST /api/ocr
 *
 * NOTE: never put the Gemini key here — this file is committed. Add it as a
 * Secret instead (dashboard → Settings → Variables and Secrets → Secret, or
 * `npx wrangler secret put GEMINI_API_KEY`). Secrets survive deploys.
 */
{
  "name": "stotramulu",
  "main": "src/index.js",
  // Pinned to what the installed wrangler/workerd binary supports (see
  // package.json's wrangler pin — the npm registry used at the time this was
  // set lagged the newest wrangler releases). Bump this back up once
  // `npm view wrangler version` shows a newer release available to you.
  "compatibility_date": "2026-08-06",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/ocr must reach the Worker even though it isn't a file on disk.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  }
}
